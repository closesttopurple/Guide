---
import TextLayout from "../../layouts/TextLayout.astro";
---

<TextLayout>
</TextLayout><style>    body {
  background-color: $bgColor;
  background-size: 6px 6px;
  background-image: linear-gradient(90deg, transparent, transparent 3px, rgba(0,0,0,.07) 4px),
    linear-gradient(transparent, transparent 3px, rgba(0,0,0,.07) 4px);
  color: $color;
  margin: 0;
  min-height: 100vh;
  box-shadow: inset 0 0 150px rgba($color, .4), inset 0 0 150px rgba($color, .3);
  
  display: flex;
  min-height: 100vh;
  flex-direction: column;
}                                               
@media (prefers-color-scheme: light)
{
    body {
  background-color: $bgColor;
  background-size: 6px 6px;
  background-image: linear-gradient(90deg, transparent, transparent 3px, rgba(213, 213, 213, 0.07) 4px),
    linear-gradient(transparent, transparent 3px, rgba(213, 213, 213, 0.07) 4px);
  color: $color;
  margin: 0;
  min-height: 100vh;
  box-shadow: inset 0 0 150px rgba($color, .4), inset 0 0 150px rgba($color, .3);
  
  display: flex;
  min-height: 100vh;
  flex-direction: column;
}
}
img{
  max-width: 30vw;
}
</style>
<style>

div{
  text-align: center;
}
@media screen and (orientation: portrait) {
  .line{
  margin-top: 6.5%;
}
.para u a{
  margin-top: 5%;
  margin-bottom: 30px;
}
.para{
    font-size: 135%;
        text-indent: 0em;
}
}
.img-special{
max-width: 35vw;
} 
@media (min-width: 1601px)  { .Guide { grid-template-columns: repeat(3, 1fr);} }
@media (max-width: 1200px)  { .img-special{ max-width: 40vw;} .Guide { grid-template-columns: repeat(2, 1fr);} }
@media (min-width: 1201px) and (max-width: 1600px)  { .Guide { grid-template-columns: repeat(3, 1fr);} }
.title{
    letter-spacing: 1px;
}
</style>

<title>Karis's Guide</title>
<p style="margin-top: 1cm; font-size: 250%;" class="title-box title-special">Ball Knowledge Guide</p>
